# --- Node API (apps/api) ---
PORT=3000
NODE_ENV=development
# SQLite file, relative to prisma/schema.prisma (zero-infra local mode).
# For PostgreSQL use: postgresql://postgres:postgres@localhost:5432/rppg
DATABASE_URL="file:./dev.db"
ML_SERVICE_URL=http://localhost:8000
STORAGE_DIR=./storage
UPLOADS_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=500
CORS_ORIGIN=http://localhost:5173

# --- Python ML service (services/ml) ---
ML_HOST=0.0.0.0
ML_PORT=8000
RPPG_DEFAULT_METHOD=pos
RPPG_WINDOW_SECONDS=12
RPPG_STEP_SECONDS=3
# Optional: a trained scikit-learn model. When absent the service falls
# back to the clearly-labelled heuristic classifier.
# MODEL_PATH=./models/production/baseline.joblib
FACE_LANDMARKER_MODEL_PATH=./services/ml/models_assets/face_landmarker.task
